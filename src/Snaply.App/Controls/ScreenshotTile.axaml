<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Snaply.App.ViewModels"
             xmlns:c="using:Snaply.App.Controls"
             x:Class="Snaply.App.Controls.ScreenshotTile"
             x:DataType="vm:ScreenshotItemViewModel"
             Width="220">
  <Button Classes="tile" Classes.selected="{Binding IsSelected}"
          Command="{Binding ClickCommand, RelativeSource={RelativeSource AncestorType=c:ScreenshotTile}}"
          CommandParameter="{Binding}"
          AutomationProperties.Name="{Binding FileName}"
          ToolTip.Tip="{Binding FileName}">
    <Grid RowDefinitions="Auto,Auto">
      <Border Height="138" CornerRadius="7,7,0,0" ClipToBounds="True" Background="{DynamicResource SurfaceAltBrush}">
        <Grid>
          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
          <StackPanel IsVisible="{Binding IsMissing}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
            <c:Icon Data="{DynamicResource IconImageOff}" Size="26" HorizontalAlignment="Center" />
            <TextBlock Text="File missing" Classes="caption secondary" HorizontalAlignment="Center" />
          </StackPanel>
          <Border IsVisible="{Binding IsFavorite}" Background="#99000000" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
            <c:Icon Data="{DynamicResource IconStar}" Size="13" Stroke="#FFD60A" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Border Background="#99000000" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8">
            <TextBlock Text="{Binding FormatLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
          </Border>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="12,10,12,12" Spacing="2" HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding FileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Subtitle}" Classes="caption secondary" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding CreatedText}" Classes="caption tertiary" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
      </StackPanel>
    </Grid>
  </Button>
</UserControl>
