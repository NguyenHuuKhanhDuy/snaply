<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Snaply.App.Controls">

  <ControlTheme x:Key="{x:Type c:EmptyState}" TargetType="c:EmptyState">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="380">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource SurfaceAltBrush}" HorizontalAlignment="Center">
            <c:Icon Data="{TemplateBinding Icon}" Size="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="6">
            <TextBlock Text="{TemplateBinding Title}" Classes="subtitle" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="{TemplateBinding Description}" Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
          </StackPanel>
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:SettingsRow}" TargetType="c:SettingsRow">
    <Setter Property="Padding" Value="0,12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" Margin="{TemplateBinding Padding}">
          <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
            <TextBlock Text="{TemplateBinding Title}" FontWeight="Medium" />
            <TextBlock Text="{TemplateBinding Description}" Classes="caption secondary" TextWrapping="Wrap"
                       IsVisible="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:SectionCard}" TargetType="c:SectionCard">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="10">
          <StackPanel Spacing="2" Margin="2,0">
            <TextBlock Text="{TemplateBinding Title}" Classes="subtitle" />
            <TextBlock Text="{TemplateBinding Description}" Classes="caption secondary" TextWrapping="Wrap"
                       IsVisible="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Border Classes="card" Padding="18,6">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:KeyCaps}" TargetType="c:KeyCaps">
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsControl ItemsSource="{TemplateBinding Parts}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1,1,1,2"
                      CornerRadius="5" Padding="7,2" MinWidth="24">
                <TextBlock Text="{Binding}" Classes="caption" FontWeight="Medium" HorizontalAlignment="Center" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
