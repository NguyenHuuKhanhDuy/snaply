<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Snaply.App.ViewModels"
        xmlns:svc="using:Snaply.App.Services"
        xmlns:c="using:Snaply.App.Controls"
        x:Class="Snaply.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Snaply"
        Icon="/Assets/snaply.ico"
        Width="1240" Height="800" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

  <Window.Styles>
    <Style Selector="Border#Sidebar">
      <Setter Property="Width" Value="236" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#Sidebar.collapsed">
      <Setter Property="Width" Value="64" />
    </Style>
    <Style Selector="Border#Sidebar.collapsed :is(Control).hideWhenCollapsed">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border#Sidebar.collapsed Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.toast">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ElevationMd}" />
    </Style>
  </Window.Styles>

  <Grid>
    <Grid ColumnDefinitions="Auto,*">
      <!-- Sidebar -->
      <Border x:Name="Sidebar" Classes.collapsed="{Binding IsSidebarCollapsed}" Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsVisible="{Binding ShowShell}" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12,14,12,12">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0,0,14" Height="32">
            <Image Source="/Assets/snaply-64.png" Width="32" Height="32" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Grid.Column="1" Text="Snaply" Classes="subtitle hideWhenCollapsed" VerticalAlignment="Center" Margin="10,0,0,0" />
            <Button Grid.Column="2" Classes="icon hideWhenCollapsed" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Collapse sidebar" AutomationProperties.Name="Collapse sidebar">
              <c:Icon Data="{DynamicResource IconSidebar}" Size="16" />
            </Button>
          </Grid>

          <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,14">
            <Button Classes="primary" HorizontalAlignment="Stretch" Command="{Binding CaptureRegionCommand}" ToolTip.Tip="Capture a region" AutomationProperties.Name="Capture region">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <c:Icon Data="{DynamicResource IconCapture}" Size="17" />
                <TextBlock Text="Capture" Classes="hideWhenCollapsed" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding CaptureFullScreenCommand}" ToolTip.Tip="Capture the full screen" AutomationProperties.Name="Capture full screen">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <c:Icon Data="{DynamicResource IconMonitor}" Size="17" />
                <TextBlock Text="Full screen" Classes="hideWhenCollapsed" />
              </StackPanel>
            </Button>
          </StackPanel>

          <ItemsControl Grid.Row="2" ItemsSource="{Binding NavItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItemViewModel">
                <Button Classes="nav" Classes.active="{Binding IsActive}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).GoCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <c:Icon Data="{Binding Icon}" Size="18" />
                    <TextBlock Text="{Binding Label}" Classes="hideWhenCollapsed" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Grid.Row="3" Spacing="4">
            <Button Classes="icon" HorizontalAlignment="Center" Command="{Binding ToggleSidebarCommand}" IsVisible="{Binding IsSidebarCollapsed}"
                    ToolTip.Tip="Expand sidebar" AutomationProperties.Name="Expand sidebar">
              <c:Icon Data="{DynamicResource IconSidebar}" Size="16" />
            </Button>
            <TextBlock Text="Local only · nothing leaves this device" Classes="caption tertiary hideWhenCollapsed" TextWrapping="Wrap" Margin="6,6,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <!-- Update banner: only when a newer version exists; never forces anything -->
        <Border Classes="card" IsVisible="{Binding Updates.BannerVisible}" Margin="16,12,16,0" Padding="16,12"
                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" x:DataType="vm:MainViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto" DataContext="{Binding Updates}" x:DataType="vm:UpdateBannerViewModel">
            <c:Icon Data="{DynamicResource IconExport}" Size="20" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Classes="caption secondary" TextTrimming="CharacterEllipsis" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,6,0,0" MaxWidth="360" HorizontalAlignment="Left" IsVisible="{Binding ShowProgress}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Classes="ghost" Content="Release notes" Command="{Binding ShowNotesCommand}" IsVisible="{Binding HasNotes}" />
              <Button Classes="ghost" Content="Later" Command="{Binding LaterCommand}" />
              <Button Classes="secondary" Content="Install on next launch" Command="{Binding InstallOnNextLaunchCommand}" IsVisible="{Binding ShowInstallLater}" />
              <Button Classes="primary" Content="Update now" Command="{Binding UpdateNowCommand}" IsVisible="{Binding ShowUpdateNow}" />
              <Button Classes="primary" Content="Try again" Command="{Binding UpdateNowCommand}" IsVisible="{Binding ShowRetry}" />
              <Button Classes="primary" Content="Restart to update" Command="{Binding RestartCommand}" IsEnabled="{Binding RestartEnabled}" IsVisible="{Binding ShowRestart}" />
            </StackPanel>
          </Grid>
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
      </Grid>
    </Grid>

    <!-- Toasts -->
    <ItemsControl ItemsSource="{Binding Notifications.Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" IsHitTestVisible="True">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="svc:ToastItem">
          <Border Classes="toast" Width="340" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top"
                      Classes.ok="{Binding IsSuccess}" Classes.err="{Binding IsError}" Classes.warn="{Binding IsWarning}" Classes.info="{Binding IsInfo}">
                <Border.Styles>
                  <Style Selector="Border.ok"><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" /></Style>
                  <Style Selector="Border.err"><Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" /></Style>
                  <Style Selector="Border.warn"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" /></Style>
                  <Style Selector="Border.info"><Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" /></Style>
                </Border.Styles>
                <Panel>
                  <c:Icon Data="{DynamicResource IconCheck}" Size="15" Stroke="{DynamicResource SuccessBrush}" IsVisible="{Binding IsSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <c:Icon Data="{DynamicResource IconAlert}" Size="15" Stroke="{DynamicResource ErrorBrush}" IsVisible="{Binding IsError}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <c:Icon Data="{DynamicResource IconAlert}" Size="15" Stroke="{DynamicResource WarningBrush}" IsVisible="{Binding IsWarning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <c:Icon Data="{DynamicResource IconInfo}" Size="15" Stroke="{DynamicResource AccentBrush}" IsVisible="{Binding IsInfo}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,8,0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" Classes="caption secondary" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon" Width="24" Height="24" VerticalAlignment="Top" Command="{Binding DismissCommand}" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss notification">
                <c:Icon Data="{DynamicResource IconClose}" Size="13" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Dialog host -->
    <Grid IsVisible="{Binding Dialogs.Current, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource ScrimBrush}">
      <Border Classes="toast" Width="420" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding Dialogs.Current}" x:DataType="svc:DialogViewModel">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding Title}" Classes="subtitle" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" Classes="secondary" TextWrapping="Wrap" />
          <TextBox Text="{Binding InputText}" Watermark="{Binding InputWatermark}" IsVisible="{Binding HasInput}" x:Name="DialogInput" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
            <Button Classes="secondary" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsVisible="{Binding HasCancel}" />
            <Button Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsVisible="{Binding IsPrimary}" IsDefault="{Binding IsPrimary}" />
            <Button Classes="danger" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsVisible="{Binding IsDanger}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
