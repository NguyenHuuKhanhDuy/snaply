<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Snaply.App.ViewModels"
             xmlns:c="using:Snaply.App.Controls"
             xmlns:v="using:Snaply.App.Views"
             x:Class="Snaply.App.Views.EditorPage"
             x:DataType="vm:EditorViewModel"
             Focusable="True">
  <UserControl.Styles>
    <!-- Narrow windows: icon-only toolbar buttons and a slimmer properties panel so Save never leaves the screen -->
    <Style Selector=":is(UserControl).compact TextBlock.label"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector=":is(UserControl).compact Border#PropertiesPanel"><Setter Property="Width" Value="232" /></Style>
    <Style Selector="Button.picked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Top bar -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <Button Classes="ghost" Command="{Binding GoBackCommand}" ToolTip.Tip="Back (Esc)" AutomationProperties.Name="Back" Padding="10,6">
          <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{DynamicResource IconBack}" Size="16" /><TextBlock Text="Back" Classes="label" /></StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="10,0,0,0" VerticalAlignment="Center">
          <Button Classes="icon" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"><c:Icon Data="{DynamicResource IconUndo}" Size="17" /></Button>
          <Button Classes="icon" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"><c:Icon Data="{DynamicResource IconRedo}" Size="17" /></Button>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button Classes="icon" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out (-)" AutomationProperties.Name="Zoom out"><c:Icon Data="{DynamicResource IconZoomOut}" Size="17" /></Button>
          <TextBlock Text="{Binding ZoomText}" Classes="caption" MinWidth="42" TextAlignment="Center" VerticalAlignment="Center" />
          <Button Classes="icon" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in (+)" AutomationProperties.Name="Zoom in"><c:Icon Data="{DynamicResource IconZoomIn}" Size="17" /></Button>
          <Button Classes="icon" Command="{Binding FitCommand}" ToolTip.Tip="Fit to window (0)" AutomationProperties.Name="Fit to window"><c:Icon Data="{DynamicResource IconFit}" Size="17" /></Button>
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="icon" Command="{Binding ToggleOcrCommand}" Classes.active="{Binding ShowOcr}" ToolTip.Tip="Extract text" AutomationProperties.Name="Extract text"><c:Icon Data="{DynamicResource IconOcr}" Size="17" /></Button>
          <Button Classes="secondary" Command="{Binding CopyCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Copy the edited image (Ctrl+C)">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Data="{DynamicResource IconCopy}" Size="16" /><TextBlock Text="Copy" Classes="label" /></StackPanel>
          </Button>
          <Button Classes="secondary" Command="{Binding ExportCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Export to a file (Ctrl+E)">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Data="{DynamicResource IconExport}" Size="16" /><TextBlock Text="Export" Classes="label" /></StackPanel>
          </Button>
          <Button Classes="secondary" Command="{Binding SaveAsNewCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Add the edited image to your library as a new screenshot (Ctrl+Shift+S)">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Data="{DynamicResource IconPlus}" Size="16" /><TextBlock Text="Save as new" Classes="label" /></StackPanel>
          </Button>
          <Button Classes="primary" Command="{Binding SaveCommand}" ToolTip.Tip="Save edits (Ctrl+S). Edits are also saved when you leave.">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Data="{DynamicResource IconSave}" Size="16" /><TextBlock Text="Save" Classes="label" Foreground="{DynamicResource OnAccentBrush}" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Workspace -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
      <!-- Tool rail -->
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Width="56">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
          <ItemsControl ItemsSource="{Binding ToolButtons}" Margin="0,10">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ToolButtonViewModel">
                <Button Classes="icon" Classes.active="{Binding IsActive}" Width="38" Height="38"
                        Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).SetToolCommand}" CommandParameter="{Binding Info.Tool}"
                        ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Info.Name}">
                  <c:Icon Data="{Binding Icon}" Size="19" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Canvas -->
      <Grid Grid.Column="1" Background="{DynamicResource CanvasBrush}">
        <c:EditorCanvas x:Name="EditorSurface" Editor="{Binding}" />
        <Canvas x:Name="OverlayLayer" IsHitTestVisible="True" />

        <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <ProgressBar IsIndeterminate="True" Width="160" />
          <TextBlock Text="Opening image…" Classes="secondary" HorizontalAlignment="Center" />
        </StackPanel>

        <c:EmptyState IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Icon="{DynamicResource IconImageOff}"
                      Title="Can't open this image" Description="{Binding LoadError}">
          <Button Classes="secondary" Content="Back to library" Command="{Binding GoBackCommand}" />
        </c:EmptyState>
      </Grid>

      <!-- Properties -->
      <Border x:Name="PropertiesPanel" Grid.Column="2" Classes="panel" Width="272">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,14,16,18" Spacing="18">

            <!-- Sensitive info: scan, review, then cover only what the user picks -->
            <StackPanel x:Name="RedactionPanel" Spacing="10" DataContext="{Binding Redaction}" x:DataType="vm:RedactionViewModel">
              <TextBlock Text="Sensitive info" Classes="sectionLabel" />
              <TextBlock Classes="caption secondary" TextWrapping="Wrap" IsVisible="{Binding ShowIdleHint}"
                         Text="Look for emails, phone numbers, IP addresses, keys and tokens. Nothing is covered until you choose." />
              <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !OcrAvailable}" Text="{Binding OcrHint}" Foreground="{DynamicResource WarningBrush}" />
              <Button Classes="secondary" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}" HorizontalAlignment="Stretch" AutomationProperties.Name="Find sensitive info">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><c:Icon Data="{DynamicResource IconShield}" Size="16" /><TextBlock Text="Find sensitive info" /></StackPanel>
              </Button>
              <StackPanel IsVisible="{Binding IsScanning}" Spacing="6">
                <ProgressBar IsIndeterminate="True" Height="3" />
                <Button Classes="ghost" Content="Cancel scan" Command="{Binding CancelScanCommand}" HorizontalAlignment="Left" />
              </StackPanel>
              <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding HasSuggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RedactionGroup">
                    <StackPanel Spacing="2" Margin="0,4,0,6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Classes="ghost" Content="Select all" Command="{Binding ToggleAllCommand}" Padding="8,2" MinHeight="26" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:RedactionSuggestion">
                            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Preview}">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Preview}" FontFamily="Consolas, Menlo, monospace" />
                                <TextBlock Text="{Binding ConfidenceText}" Classes="caption tertiary" VerticalAlignment="Center" />
                              </StackPanel>
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="6" IsVisible="{Binding HasSuggestions}">
                <Button Classes="primary" Command="{Binding ApplySelectedCommand}" IsEnabled="{Binding HasChecked}" HorizontalAlignment="Stretch" AutomationProperties.Name="Cover selected">
                  <TextBlock Text="{Binding CheckedText}" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" />
                </Button>
                <Button Classes="secondary" Content="Cover all likely items" Command="{Binding ApplyLikelyCommand}" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" Content="Select all" Command="{Binding SelectAllCommand}" />
                  <Button Classes="ghost" Content="Clear" Command="{Binding ClearSelectionCommand}" />
                  <Button Classes="ghost" Content="Dismiss" Command="{Binding DismissCommand}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Spacing="6" IsVisible="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).HasRedactions}">
                <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).SaveRedactedCopyCommand}"
                        ToolTip.Tip="Saves a new image with the covered areas flattened. The copy keeps no text or editable layers." AutomationProperties.Name="Save redacted copy">
                  <TextBlock Text="Save redacted copy" HorizontalAlignment="Center" />
                </Button>
                <CheckBox IsChecked="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).DeleteOriginalAfterRedact}" Content="Delete the original afterwards" AutomationProperties.Name="Delete the original afterwards" />
              </StackPanel>
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Summary}" IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource SuccessBrush}" />
            </StackPanel>
            <Border Classes="divider" />

            <StackPanel Spacing="10" IsVisible="{Binding UsesColor}">
              <TextBlock Text="Color" Classes="sectionLabel" />
              <ItemsControl ItemsSource="{Binding Colors}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ColorChoice">
                    <Button Width="28" Height="28" Margin="0,0,6,6" Padding="0" CornerRadius="14" Background="Transparent"
                            BorderThickness="2" BorderBrush="Transparent"
                            Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).PickColorCommand}" CommandParameter="{Binding}"
                            Classes.picked="{Binding IsSelected}"
                            AutomationProperties.Name="Annotation color">
                      <Ellipse Width="20" Height="20" Fill="{Binding Brush}" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding UsesStroke}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Stroke / text size" Classes="sectionLabel" />
                <TextBlock Grid.Column="1" Text="{Binding StrokeWidth, StringFormat={}{0:0}}" Classes="caption secondary" />
              </Grid>
              <Slider Minimum="1" Maximum="16" Value="{Binding StrokeWidth}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Stroke width" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasCrop}">
              <TextBlock Text="Crop" Classes="sectionLabel" />
              <Button Classes="secondary" Command="{Binding ResetCropCommand}" HorizontalAlignment="Stretch" Content="Reset crop" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Output size" Classes="sectionLabel" />
              <ItemsControl ItemsSource="{Binding ScaleOptions}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:Int32">
                    <Button Classes="secondary" Margin="0,0,6,6" Padding="10,4" MinHeight="30" Content="{Binding StringFormat={}{0}%}"
                            Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).SetScaleCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="caption secondary"><Run Text="Result: " /><Run Text="{Binding SizeText}" /></TextBlock>
            </StackPanel>

            <Button Classes="danger" Command="{Binding DeleteSelectedCommand}" HorizontalAlignment="Stretch" IsVisible="{Binding SelectedId, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><c:Icon Data="{DynamicResource IconTrash}" Size="15" /><TextBlock Text="Delete selected" Foreground="{DynamicResource ErrorBrush}" /></StackPanel>
            </Button>

            <StackPanel IsVisible="{Binding ShowOcr}" Spacing="12">
              <Border Classes="divider" />
              <v:OcrPanel DataContext="{Binding Ocr}" />
            </StackPanel>

            <Border Classes="divider" />
            <StackPanel Spacing="4">
              <TextBlock Text="Tips" Classes="sectionLabel" />
              <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                         Text="Hold Shift for squares and 45° arrows. Space + drag (or middle mouse) pans. Ctrl + wheel zooms. Double-click text to edit it." />
              <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="Your original image is never changed. Edits are saved automatically." />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Status -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding SizeText}" Classes="caption secondary" />
        <TextBlock Grid.Column="1" Text="Redact boxes are solid and permanent in exports; blur and pixelate do not securely hide secrets. The original file is untouched." Classes="caption tertiary" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
