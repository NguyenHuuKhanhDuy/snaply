<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Snaply.App.ViewModels"
             xmlns:views="using:Snaply.App.Views"
             x:Class="Snaply.App.App"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <DataTemplate DataType="vm:GalleryViewModel"><views:GalleryPage /></DataTemplate>
    <DataTemplate DataType="vm:TagsViewModel"><views:TagsPage /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsPage /></DataTemplate>
    <DataTemplate DataType="vm:EditorViewModel"><views:EditorPage /></DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Snaply/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://Snaply/Themes/Icons.axaml" />
        <ResourceInclude Source="avares://Snaply/Controls/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#3B5BDB" RegionColor="#FFFFFF" />
        <ColorPaletteResources x:Key="Dark" Accent="#7C93F5" RegionColor="#1A1F29" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Snaply/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
